# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# LiamAgent.py loads .env automatically at startup.

BRAVE_API_KEY=

# MySQL credentials for Liam's persistent memory.
# Host/port/database name are hardcoded in agent/memory.py (192.168.0.136,
# liams_memory) since that's fixed infrastructure, not something to derive.
DB_USER=
DB_PASSWORD=

# Patrick Messenger integration (LiamServer.py / agent/server.py). Only
# needed if you're running that bridge; the GUI/CLI ignore all of these.
#
# Your own Matrix user ID — only this exact sender ever gets
# filesystem/shell tool access, regardless of which room they're in.
# Leave unset and NO ONE gets that access (safe default, not "everyone").
LIAM_OWNER_MATRIX_ID=
# The one Matrix room whose notes should be the same global notes pool
# the GUI/CLI already use, instead of a fresh isolated bucket. Every
# other room gets its own separate notes automatically.
LIAM_SHARED_NOTES_ROOM_ID=
# Fixed working directory for the owner's write_file/run_shell_command
# calls via Patrick Messenger — there's no folder picker in a chat.
# Defaults to ~/liam-messenger if unset.
LIAM_MESSENGER_WORKDIR=
# Defaults shown; override only if something else needs these ports/host.
LIAM_HTTP_HOST=127.0.0.1
LIAM_HTTP_PORT=8787
LIAM_MESSENGER_MODEL=

# Optional lightweight Ollama helper for hidden feedback/lesson processing and
# large-result relevance scans. The main answer/tool model remains local.
# Point this at a trusted LAN Ollama server running llama3.1:8b.
LIAM_HELPER_OLLAMA_URL=http://192.168.0.128:11434/api/chat
LIAM_HELPER_OLLAMA_MODEL=llama3.1:8b
LIAM_HELPER_OLLAMA_TIMEOUT=45
LIAM_HELPER_OLLAMA_KEEP_ALIVE=30m

# Local image generation (generate_image tool). Runs against a local
# ComfyUI install (sd-webui/, gitignored) always-on via the sd-webui
# systemd --user service. Only needed if you want to swap in a different
# checkpoint later — defaults to sd_xl_base_1.0.safetensors.
LIAM_SD_CHECKPOINT=

# FredPlayer media server (fredplayer_list_library/fredplayer_save_playlist
# tools). Same URL/token the FredPlayer Android app itself uses to reach
# its server (see /var/www/FredPlayer/server/.env for the token).
FREDPLAYER_MEDIA_URL=
FREDPLAYER_MEDIA_TOKEN=

# Ubuntu desktop app only: comma-separated aliases from ~/.ssh/config that
# Liam may access with ssh_list_hosts/ssh_run_command. Use SSH keys (and an
# ssh-agent for passphrases); passwords are intentionally unsupported.
# Example: LIAM_SSH_HOSTS=worklaptop,jetson,alien
LIAM_SSH_HOSTS=
